		    Navegacao = Origem{[Item="Tabela 9", Kind="Sheet"]}[Data],
		    RemoverBrancas = Table.SelectColumns(Navegacao, List.Select(Table.ColumnNames(Navegacao), each not List.IsEmpty(List.RemoveNulls(Table.Column(Navegacao, _))))),
		    ColunasUteis = Table.SelectColumns(RemoverBrancas, {"Column2", "Column3", "Column4"}),
		    DadosBrutos = Table.Skip(ColunasUteis, 5),
		    Renomeado = Table.RenameColumns(DadosBrutos, {
		        {"Column2", "Mes"}, {"Column3", "SalarioMedioAdmissao"}, {"Column4", "SalarioMedioDesligamento"}
		    }),
		    RemoverRodape = Table.SelectRows(Renomeado, each [Mes] <> null and Text.Contains(Text.From([Mes]), "/")),
		    TipoAlterado = Table.TransformColumnTypes(RemoverRodape, {{"SalarioMedioAdmissao", type number}, {"SalarioMedioDesligamento", type number}})
		in
