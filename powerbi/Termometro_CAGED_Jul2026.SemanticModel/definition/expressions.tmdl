expression stg_Tabela4 =
		let
		    Origem = Excel.Workbook(File.Contents("C:\Users\lucas.azevedo_scaffo\Downloads\termometro-caged-2026\data\3-tabelas_Julho de 2026.xlsx"), null, true),
		    Navegacao = Origem{[Item="Tabela 4", Kind="Sheet"]}[Data],
		    RemoverBrancas = Table.SelectColumns(Navegacao, List.Select(Table.ColumnNames(Navegacao), each not List.IsEmpty(List.RemoveNulls(Table.Column(Navegacao, _))))),
		    LinhaUF = Table.ToRows(Table.FirstN(Table.Skip(RemoverBrancas, 5), 1)){0},
		    DadosBrutos = Table.Skip(RemoverBrancas, 6),
		    NomesAtuais = Table.ColumnNames(DadosBrutos),
		    NovosNomes = List.Transform(List.Positions(NomesAtuais), each
		        if _ = 0 then "Setor" else if LinhaUF{_} <> null then LinhaUF{_} else NomesAtuais{_}),
		    Renomeado = Table.RenameColumns(DadosBrutos, List.Zip({NomesAtuais, NovosNomes})),
		    RemoverRodape = Table.SelectRows(Renomeado, each [Setor] <> null
		        and not Text.StartsWith(Text.Trim(Text.From([Setor])), "Fonte")
		        and not Text.StartsWith(Text.Trim(Text.From([Setor])), "*")),
		    RemoverTotalNaoIdent = Table.RemoveColumns(RemoverRodape, {"Total", "Não identificado"}),
		    Unpivot = Table.UnpivotOtherColumns(RemoverTotalNaoIdent, {"Setor"}, "UF", "Saldo"),
		    TipoAlterado = Table.TransformColumnTypes(Unpivot, {{"Saldo", Int64.Type}})
		in
		    TipoAlterado
	lineageTag: 01262a91-b84f-451e-957e-9ada7c9cc2d7

