	measure 'Estoque Nacional Contexto' =
			
			VAR ValorAtual = [Estoque Nacional]
			VAR ValorMesAnterior = CALCULATE([Estoque Nacional], DATEADD(Dim_Data[Data], -1, MONTH))
			VAR ValorAnoAnterior = CALCULATE([Estoque Nacional], DATEADD(Dim_Data[Data], -12, MONTH))
			VAR VarMoM = ValorAtual - ValorMesAnterior
			VAR VarYoYPct = DIVIDE(ValorAtual - ValorAnoAnterior, ABS(ValorAnoAnterior))
			RETURN
			    "vs mês anterior: " & FORMAT(VarMoM, "+#,##0;-#,##0") &
			    "  |  vs ano anterior: " & FORMAT(VarYoYPct, "+0.0%;-0.0%")
		displayFolder: Emprego
		lineageTag: 2007a440-6129-4fe1-9a94-70ad80e31742

	measure 'Saldo Nacional Contexto' = ```
			
			VAR ValorAtual = [Saldo Nacional]
