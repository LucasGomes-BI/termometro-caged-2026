	measure 'Taxa Rotatividade Recalculada' =
			
			DIVIDE(
			    ([Admissoes Rotatividade] + [Desligamentos Rotatividade]) / 2,
			    [Estoque Medio Rotatividade]
			)
		displayFolder: Rotatividade
		lineageTag: dad4a23f-1ce3-4dd8-b036-7f645df43fa1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taxa Rotatividade UF Recalculada' =
			
			CALCULATE(
			    DIVIDE(
			        (SUM(Fato_Rotatividade_UF[Admissoes]) + SUM(Fato_Rotatividade_UF[Desligamentos])) / 2,
			        SUM(Fato_Rotatividade_UF[EstoqueMedio])
			    ),
			    Fato_Rotatividade_UF[Nivel] = "UF"
			)
		displayFolder: Rotatividade
		lineageTag: fe8958d3-5534-4b93-88e1-b22f6f0d62f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

