	measure 'Subtitulo Grafico A' =
			
			"Saldo nacional: " &
			FORMAT(CALCULATE([Saldo Setor A], ALL(Dim_UF)), "+#,##0;-#,##0")
		displayFolder: Saldo Setor
		lineageTag: bf46fda1-6457-49e9-a926-f2273b5632fa

	measure 'Subtitulo Grafico B' =
			
			"Saldo nacional do setor: " &
			FORMAT(CALCULATE([Saldo Setor B], ALL(Dim_UF)), "+#,##0;-#,##0")
		displayFolder: Saldo Setor
		lineageTag: d1512b63-5e86-4821-9aba-af4ae1cc818e

	measure 'Resumo Comparativo A x B' =
			
			VAR SetorA = SELECTEDVALUE(Dim_Setor_A[Setor], "Setor A")
			VAR SetorB = SELECTEDVALUE(Dim_Setor_B[Setor], "Setor B")
			VAR TotalA = CALCULATE([Saldo Setor A], ALL(Dim_UF))
			VAR TotalB = CALCULATE([Saldo Setor B], ALL(Dim_UF))
			VAR Lider = IF(TotalA > TotalB, SetorA, SetorB)
			VAR Diferenca = ABS(TotalA - TotalB)
			VAR TabelaComparacao =
			    ADDCOLUMNS(
			        VALUES(Dim_UF[UF]),
			        "ValA", CALCULATE([Saldo Setor A]),
			        "ValB", CALCULATE([Saldo Setor B])
			    )
			VAR QtdEstadosA = COUNTROWS(FILTER(TabelaComparacao, [ValA] > [ValB]))
			VAR QtdEstadosB = COUNTROWS(FILTER(TabelaComparacao, [ValB] > [ValA]))
			VAR QtdTotal = COUNTROWS(TabelaComparacao)
			RETURN
			    SetorA & " gerou " & FORMAT(TotalA, "+#,##0;-#,##0") & " vagas líquidas nacionalmente; " &
			    SetorB & " gerou " & FORMAT(TotalB, "+#,##0;-#,##0") & ". " &
			    Lider & " liderou por " & FORMAT(Diferenca, "#,##0") & " vagas. " &
			    SetorA & " venceu em " & QtdEstadosA & " de " & QtdTotal & " estados; " &
			    SetorB & " venceu em " & QtdEstadosB & "."
		displayFolder: Saldo Setor
		lineageTag: e1f2e35d-0bec-460d-beca-6d6a6f976a0c

	measure 'Teste 3 Texto Exato' =
			
			COUNTROWS(
			    FILTER(
			        Fato_Saldo_UF_Setor,
			        EXACT([Setor], "Administração Pública, Defesa E Seguridade Social, Educação, Saúde Humana E Serviços Sociais")
			    )
			)
		formatString: 0
		displayFolder: Saldo Setor
		lineageTag: db499039-cfe8-43e9-a89f-4c9ad335ac24

	measure 'Resumo Estados' =
			
			VAR SetorSelecionado = SELECTEDVALUE(Dim_Setor[Setor], "todos os setores")
			VAR TabelaEstados =
			    ADDCOLUMNS(
			        VALUES(Dim_UF[UF]),
			        "Val", CALCULATE([Saldo UF])
			    )
			VAR TotalNacional = SUMX(TabelaEstados, [Val])
			VAR Lider = TOPN(1, TabelaEstados, [Val], DESC)
			VAR NomeLider = MAXX(Lider, [UF])
			VAR ValorLider = MAXX(Lider, [Val])
			VAR PctLider = DIVIDE(ValorLider, TotalNacional)
			VAR SegundoColocado = TOPN(1, FILTER(TabelaEstados, [UF] <> NomeLider), [Val], DESC)
			VAR NomeSegundo = MAXX(SegundoColocado, [UF])
			VAR ValorSegundo = MAXX(SegundoColocado, [Val])
			VAR QtdNegativos = COUNTROWS(FILTER(TabelaEstados, [Val] < 0))
			RETURN
			    NomeLider & " lidera com " & FORMAT(ValorLider, "+#,##0;-#,##0") &
			    " vagas líquidas (" & FORMAT(PctLider, "0.0%") & " do saldo nacional em " & SetorSelecionado & "), " &
			    FORMAT(ValorLider - ValorSegundo, "#,##0") & " à frente de " & NomeSegundo & ". " &
			    QtdNegativos & " estado(s) tiveram saldo negativo no período."
		displayFolder: Saldo Setor
		lineageTag: 04de7ce7-4ccb-4d9c-8142-6900672b4ff5

	measure 'Saldo Setor Jul2026' =
			
			CALCULATE(
			    SUM(Fato_Serie_Mensal[Valor]),
			    Fato_Serie_Mensal[Metrica] = "Saldos",
			    Fato_Serie_Mensal[Mes] = "Julho/2026"
			)
		displayFolder: Saldo Setor
		lineageTag: 094f4159-eedd-486e-b5bf-6e8f3445a618

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Resumo Rotatividade Salario' =
			
			VAR TabelaSetor =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(Dim_Setor[Setor]),
			            "Taxa", CALCULATE([Taxa Rotatividade (linha única)]),
			            "Saldo", CALCULATE([Saldo Setor Jul2026]),
			            "NivelSetor", CALCULATE(MAX(Dim_Setor[Nivel]))
			        ),
			        [NivelSetor] = 1
			    )
			VAR MaiorRotatividade = TOPN(1, TabelaSetor, [Taxa], DESC)
			VAR NomeSetor = MAXX(MaiorRotatividade, [Setor])
			VAR TaxaSetor = MAXX(MaiorRotatividade, [Taxa]) / 100
			VAR SaldoSetor = MAXX(MaiorRotatividade, [Saldo])
			VAR TendenciaSaldo = IF(SaldoSetor >= 0, "positivo", "negativo")
			VAR GapAtual =
			    CALCULATE(
			        [Gap Salarial %],
			        Fato_Salario_Nacional[Mes] = "Julho/2026"
			    )
			RETURN
			    NomeSetor & " tem a maior rotatividade entre os setores (" & FORMAT(TaxaSetor, "0.0%") &
			    "), com saldo " & TendenciaSaldo & " de " & FORMAT(SaldoSetor, "+#,##0;-#,##0") &
			    " vagas em jul/2026 - alta renovação não significa necessariamente encolhimento. " &
			    "No mesmo mês, o salário real de desligamento ficou " &
			    FORMAT(GapAtual, "+0.0%;-0.0%") & " em relação ao de admissão."
		displayFolder: Rotatividade
		lineageTag: 11369648-c41b-461f-92bc-07bb4ab696f0

	measure 'Saldo Nivel1' =
			
			CALCULATE(
			    SUM(Fato_Serie_Mensal[Valor]),
			    Fato_Serie_Mensal[Metrica] = "Saldos",
			    Fato_Serie_Mensal[EhTotal] = FALSE
			)
		displayFolder: Saldo Setor
		lineageTag: 1c1fdefe-fcc9-4abb-802b-3d7a13aae07d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cor Dinamica Setor' =
			
			SWITCH(
			    SELECTEDVALUE(Dim_Setor[Setor (Legenda)]),
			    "Agricultura, Pecuária, Produção Florestal, Pesca E Aquicultura", "#2F7566",
			    "Comércio; Reparação De Veículos Automotores E Motocicletas", "#6B7F8C",
			    "Construção", "#C4802E",
			    "Indústria Geral", "#16324F",
			    "Serviços", "#A3403B",
			    "#B8C2CA"
			)
		displayFolder: Saldo Setor
		lineageTag: 9fddb044-7b4e-4450-94d5-42b095e98ace

	measure 'Resumo Evolucao Setor' =
			
			VAR TabelaSetor =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(Dim_Setor[Setor]),
			            "SaldoAtual", CALCULATE([Saldo Nivel1], Fato_Serie_Mensal[Mes] = "Julho/2026"),
			            "SaldoMinPandemia",
			                CALCULATE(
			                    MINX(VALUES(Fato_Serie_Mensal[Mes]), [Saldo Nivel1]),
			                    Fato_Serie_Mensal[Mes] IN {"Janeiro/2020", "Fevereiro/2020", "Março/2020", "Abril/2020"}
			                ),
			            "NivelSetor", CALCULATE(MAX(Dim_Setor[Nivel]))
			        ),
			        [NivelSetor] = 1
			    )
			VAR MaiorQueda = TOPN(1, TabelaSetor, [SaldoMinPandemia], ASC)
			VAR NomeMaiorQueda = MAXX(MaiorQueda, [Setor])
			VAR ValorMaiorQueda = MAXX(MaiorQueda, [SaldoMinPandemia])
			VAR MelhorRecuperacao = TOPN(1, TabelaSetor, [SaldoAtual], DESC)
			VAR NomeMelhorRecuperacao = MAXX(MelhorRecuperacao, [Setor])
			VAR ValorAtualMelhor = MAXX(MelhorRecuperacao, [SaldoAtual])
			RETURN
			    NomeMaiorQueda & " teve a queda mais severa na pandemia (" &
			    FORMAT(ValorMaiorQueda, "+#,##0;-#,##0") & " em 2020). " &
			    "Em jul/2026, " & NomeMelhorRecuperacao & " lidera o saldo mensal com " &
			    FORMAT(ValorAtualMelhor, "+#,##0;-#,##0") & " vagas líquidas."
		displayFolder: Saldo Setor
		lineageTag: 33a2afe5-3eb1-46b4-93ca-b66f2a839135

	column 'Coluna 1'
		dataType: string
		isHidden
		lineageTag: 06ddab14-f477-472a-928e-c4a65239c20d
		summarizeBy: none
		sourceColumn: Coluna 1

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Medida = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}})
				in
				    #"Tipo Alterado"

	changedProperty = Name

	annotation PBI_ResultType = Table

