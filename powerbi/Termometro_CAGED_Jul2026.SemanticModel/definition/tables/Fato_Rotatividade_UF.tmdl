	partition Fato_Rotatividade_UF = m
		mode: import
		source =
				let
				    Origem = stg_Tabela11,
				    Regioes = {"Norte","Nordeste","Sudeste","Sul","Centro-Oeste"},
				    AddNivel = Table.AddColumn(Origem, "Nivel", each
				        if [UF] = "Brasil" then "Brasil"
				        else if List.Contains(Regioes, [UF]) then "Região"
				        else "UF")
				in
				    AddNivel

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

